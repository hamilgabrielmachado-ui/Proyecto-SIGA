# Copie este archivo como ".env" y complete sus datos. NUNCA suba ".env" al repositorio.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=siga_nueva

# Usuario administrador inicial (se crea una sola vez).
# Si ADMIN_PASSWORD queda vacío, se genera una clave temporal y se muestra en la consola.
ADMIN_USER=admin
ADMIN_PASSWORD=
